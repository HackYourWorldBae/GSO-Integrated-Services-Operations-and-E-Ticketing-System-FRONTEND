# ============================================================
# GSO Frontend Environment Template
# Copy to `.env` and set the backend URL for your environment.
# Vite only exposes variables prefixed with VITE_ to browser code.
# ============================================================

# Local dev (php spark serve default):
VITE_API_URL=http://localhost:8080/api/v1

# Production (uncomment for the bsu.edu.ph subdomain deploy):
# VITE_API_URL=https://backend.hywb.online/api/v1
